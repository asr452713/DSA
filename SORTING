#include <stdio.h>
#include <stdlib.h>

void bubble() {
    int n;
    printf("\nHow many student percentages you wanna enter: ");
    scanf("%d", &n);
    float arr[n];
    
    printf("Enter percentages: ");
    for (int i = 0; i < n; i++) {
        scanf("%f", &arr[i]);
    }

    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j+1]) {
                float temp = arr[j];
                arr[j] = arr[j+1];
                arr[j+1] = temp;
            }
        }
    }

    printf("\nSorted array: ");
    for (int i = 0; i < n; i++) {
        printf("%.2f ", arr[i]);
    }
    
    printf("\nTop 5: ");
    for (int i = n - 1; i > n - 6 && i >= 0; i--) {
        printf("%.2f ", arr[i]);
    }
    printf("\n");
}

void selection() {
    int n, min;
    printf("\nHow many student percentages you wanna enter: ");
    scanf("%d", &n);
    float arr[n];
    
    printf("Enter percentages: ");
    for (int i = 0; i < n; i++) {
        scanf("%f", &arr[i]);
    }

    for (int i = 0; i < n - 1; i++) {
        min = i;
        for (int j = i + 1; j < n; j++) {
            if (arr[j] < arr[min]) {
                min = j;
            }
        }
        float temp = arr[i];
        arr[i] = arr[min];
        arr[min] = temp;
    }

    printf("\nSorted array: ");
    for (int i = 0; i < n; i++) {
        printf("%.2f ", arr[i]);
    }
    
    printf("\nTop 5: ");
    for (int i = n - 1; i > n - 6 && i >= 0; i--) {
        printf("%.2f ", arr[i]);
    }
    printf("\n");
}

int main() {
    int ch;
    while (1) {
        printf("\n1. Bubble sort\n2. Selection sort\n3. Exit\nEnter choice: ");
        scanf("%d", &ch);
        
        switch (ch) {
            case 1:
                bubble();
                break;
            case 2:
                selection();
                break;
            case 3:
                exit(0);
                break;
            default:
                printf("\nerror\n");
        }
    }
    return 0;
}
