#include<stdio.h>   
#include<stdlib.h>
  

int b,n;
int flag=0;
int mid;
int a[100];

void binary()

 {
   flag=0;
   mid=0;
   int low=0;
   int high=n-1;
    while(low<=high) 
        { 
          mid=(low+high)/2;
          if(b==a[mid])
          {
            flag=1;
            break;
          }
          else if(b<a[mid])
          {     
            high=mid-1;
          }
          else
          {
            low=mid+1;
          }
        } 

          if(flag==1)
          {
            printf("FOUND");
          }
          else
          {
            printf("NOT FOUND");
          }
        }

void linear()
{
  flag=0;
  for(int i=0;i<n;i++)
  {
    if(b==a[i])
    {
      flag=1;
      break;
    }
  }
    if(flag==1)
    {
      printf("\nFOUND");
    }

    else 
    {
      printf("\nNOT FOUND");
    }
 }

